# syntax=docker/dockerfile:1
# SPDX-License-Identifier: Apache-2.0
#
# The EtherNet/IP adapter process, with the real OpENer stack linked in.
#
# This is the container that is allowed to crash.  It holds the network-facing
# CIP implementation and nothing else, so a fault here costs the plant a
# failsafe transition rather than the PLC.  It carries no restart policy of its
# own: `restart:` in compose, or a Deployment's restartPolicy, owns that.

FROM debian:bookworm-slim AS build

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential cmake ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY CMakeLists.txt ./
COPY cmake        ./cmake
COPY include      ./include
COPY src          ./src
COPY examples     ./examples
COPY tests        ./tests
COPY third_party  ./third_party

# Fail loudly rather than silently falling back to the mirror backend: an
# image built from a missing submodule would come up, serve nothing, and look
# healthy.
RUN test -f third_party/OpENer/source/src/opener_api.h \
    || (echo "third_party/OpENer is empty - run 'git submodule update --init --recursive' before building" >&2; exit 1)

RUN cmake -S . -B build \
        -DCMAKE_BUILD_TYPE=RelWithDebInfo \
        -DSOFTPLC_WITH_EIP=ON \
        -DSOFTPLC_WITH_OPENER=ON \
        -DSOFTPLC_BUILD_TESTS=OFF \
    && cmake --build build -j"$(nproc)" --target softplc-eip-adapter

FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
        libstdc++6 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=build /src/build/softplc-eip-adapter /usr/local/bin/softplc-eip-adapter

VOLUME ["/dev/shm"]

# EtherNet/IP: TCP 44818 for explicit messaging and connection setup,
# UDP 2222 for class 1 cyclic I/O, UDP 44818 for ListIdentity broadcasts.
EXPOSE 44818/tcp 44818/udp 2222/udp

# Runs as root, and is granted CAP_NET_RAW / CAP_NET_ADMIN in compose, which
# were granted defensively rather than measured.  Running the same OpENer
# build as an unprivileged uid with no capabilities at all does in fact come
# up and serve - it reads the interface MAC by ioctl and binds 44818 and 2222,
# none of which is privileged (see docker/README.md).  Narrowing this is worth
# doing; it is left alone here because this deployment is verified as it
# stands and the change deserves its own container test.  What CAP_DAC_OVERRIDE
# is genuinely for is the split itself: this container is root and the shared
# memory was created 0600 by uid 10001.  The all-in-one image needs no
# capabilities precisely because one container means one uid.

# No SOFTPLC_* defaults are set here, deliberately.
#
# The environment wins over a mounted config file - which is what makes
# `docker run -e` and a compose `environment:` block work - so a default baked
# in here would not be a default at all: it would silently override whatever
# the operator wrote in /etc/softplc/softplc.conf.  The binary's own defaults
# are the same values, and `softplc --show-config` prints them.

ENTRYPOINT ["/usr/local/bin/softplc-eip-adapter"]
