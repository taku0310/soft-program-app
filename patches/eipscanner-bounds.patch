diff --git a/src/ConnectionManager.cpp b/src/ConnectionManager.cpp
index a4c76a2..2bb602e 100644
--- a/src/ConnectionManager.cpp
+++ b/src/ConnectionManager.cpp
@@ -237,21 +237,43 @@ namespace eipScanner {
 			});
 
 			newSocket->setBeginReceiveHandler([this](BaseSocket& sock) {
-				auto recvData = sock.Receive(8192);
-				CommonPacket commonPacket;
-				commonPacket.expand(recvData);
-
-				// TODO: Check TypeIDs and sequence of the packages
-				Buffer buffer(commonPacket.getItems().at(0).getData());
-				cip::CipUdint connectionId;
-				buffer >> connectionId;
-				Logger(LogLevel::DEBUG) << "Received data from connection T2O_ID=" << connectionId;
-
-				auto io = _connectionMap.find(connectionId);
-				if (io != _connectionMap.end()) {
-					io->second->notifyReceiveData(commonPacket.getItems().at(1).getData());
-				} else {
-					Logger(LogLevel::ERROR) << "Received data from unknown connection T2O_ID=" << connectionId;
+				/* Anything at all can arrive on this socket: it is a UDP port
+				 * on a plant network. A malformed datagram must cost one
+				 * dropped frame, not the process - and this handler runs
+				 * inside select(), so an exception leaving it unwinds out
+				 * through the C caller that drives the service loop. */
+				try {
+					auto recvData = sock.Receive(8192);
+					CommonPacket commonPacket;
+					commonPacket.expand(recvData);
+
+					// TODO: Check TypeIDs and sequence of the packages
+					if (commonPacket.getItems().size() < 2) {
+						Logger(LogLevel::ERROR) << "Ignoring a datagram with "
+							<< commonPacket.getItems().size()
+							<< " common packet item(s); a connected data "
+							   "message has two";
+						return;
+					}
+
+					Buffer buffer(commonPacket.getItems().at(0).getData());
+					cip::CipUdint connectionId;
+					buffer >> connectionId;
+					if (!buffer.isValid()) {
+						Logger(LogLevel::ERROR) << "Ignoring a datagram whose "
+							"address item is too short to hold a connection id";
+						return;
+					}
+					Logger(LogLevel::DEBUG) << "Received data from connection T2O_ID=" << connectionId;
+
+					auto io = _connectionMap.find(connectionId);
+					if (io != _connectionMap.end()) {
+						io->second->notifyReceiveData(commonPacket.getItems().at(1).getData());
+					} else {
+						Logger(LogLevel::ERROR) << "Received data from unknown connection T2O_ID=" << connectionId;
+					}
+				} catch (const std::exception& e) {
+					Logger(LogLevel::ERROR) << "Dropping a malformed datagram: " << e.what();
 				}
 			});
 
diff --git a/src/utils/Buffer.cpp b/src/utils/Buffer.cpp
